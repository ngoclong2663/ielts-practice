# Gin API (server side). Browser calls go through the /api/v1 rewrite to this URL.
API_URL=http://localhost:8080

# Google OAuth: same client as the backend. The redirect URL must be registered in
# Google Cloud Console → Credentials → Authorized redirect URIs.
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
