# Shared secrets for local development. Copy to `.env` (git-ignored) and fill in.
# The API (be/) loads be/.env first, then this file; a variable already set is never overridden.
# App-specific settings live in be/.env.example and fe/.env.example.

# ---- Google sign-in (Google Cloud Console → APIs & Services → Credentials) ----
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ---- Card generation (Epic 3 and 4) ----
# Claude writes cards and topic word lists: create a key at console.anthropic.com → API Keys (starts with sk-ant-api).
# A Claude subscription token (from `claude setup-token`) does not work here.
ANTHROPIC_API_KEY=
# Gemini answers what Claude could not, or everything when only this key is set (aistudio.google.com → API keys).
GEMINI_API_KEY=
# Card generation models: Claude first, Gemini for the words Claude could not answer.
VOCAB_LLM_MODEL=claude-haiku-5-5
# Leave unset for the default; set it to an empty value to turn the fallback off.
VOCAB_FALLBACK_MODEL=gemini-3.1-flash-lite

# ---- Images (hotlinked from the providers, never stored) ----
# pixabay.com/api/docs
PIXABAY_API_KEY=
# unsplash.com/oauth/applications
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
