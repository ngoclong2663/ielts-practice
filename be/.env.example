# ---- Server ----
# development | test | production
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
# Production behind Vercel rewrites + Railway proxy: TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# ---- Database (DATABASE_URL wins; Railway injects it automatically) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ielts_practice?sslmode=disable

# ---- Auth ----
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Google OAuth (Google Cloud Console → Credentials → OAuth client "Web application") ----
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# ---- Card generation (Epic 3) ----
# Claude writes the card content. Without a key, generation fails with VOCAB_GENERATOR_NOT_CONFIGURED.
ANTHROPIC_API_KEY=
VOCAB_LLM_MODEL=claude-haiku-5-5
VOCAB_LLM_EFFORT=low
# Gemini answers the words Claude could not (errors, overload, refusals), or every word when only
# GEMINI_API_KEY is set. Leave VOCAB_FALLBACK_MODEL unset for the default; set it empty to disable.
GEMINI_API_KEY=
VOCAB_FALLBACK_MODEL=gemini-3.1-flash-lite
# Background generation goroutines and the per-user limit of newly generated words per 24 h.
VOCAB_WORKERS=4
VOCAB_DAILY_QUOTA=20
# Words by topic (Epic 4): AI word-list requests per user per 24 h (a new list or "Suggest more").
VOCAB_DAILY_SUGGESTIONS=5
# Image search order. Images are hotlinked from the providers, never stored in S3.
VOCAB_IMAGE_PROVIDERS=pixabay,unsplash
PIXABAY_API_KEY=
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
# Offline fakes for Claude and the image APIs (development and e2e only; ignored in production).
VOCAB_FAKE_PROVIDERS=false

# ---- Object storage (S3), reserved for future user uploads ----
S3_BUCKET_NAME=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible servers (MinIO / RustFS), e.g. http://localhost:9000
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---- Writing practice (Epic 5): uses the card-generation models above ----
# AI calls per user per 24 h: paragraph checks and full-answer reviews (lessons are shared and not counted).
WRITING_DAILY_CHECKS=30
WRITING_DAILY_SUBMISSIONS=5
# Library candidates (Epic 9): an AI-made card is offered for the library once this many learners keep it in a deck.
LIBRARY_CANDIDATE_MIN_USERS=3

# ---- Feedback (Epic 6) ----
# Feedback messages per user per 24 h (FEEDBACK_LIMIT when reached).
FEEDBACK_DAILY_LIMIT=10
# Each new feedback is posted to a Telegram group. Both token and chat id are needed, otherwise
# notifications are off (never sent with APP_ENV=test or VOCAB_FAKE_PROVIDERS=true).
# Create a bot with @BotFather, add it to the group, send one message there, then read the chat id
# from https://api.telegram.org/bot<token>/getUpdates (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a topic id in a forum group.
TELEGRAM_THREAD_ID=

# ---- Admin board (Epic 6) ----
# `api seed` creates (or updates the password of) this admin account; skipped when either is empty.
# The password is stored as a bcrypt hash; at least 12 characters in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Lifetime of an admin sign-in (its JWT secret is derived from JWT_SECRET).
ADMIN_SESSION_TTL=12h
# Days on the board (today, 7 and 30 days, the daily chart) are counted in this time zone.
ADMIN_TIMEZONE=Asia/Ho_Chi_Minh
