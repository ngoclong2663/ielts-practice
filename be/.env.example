# ---- Server ----
# development | test | production
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
# Production behind Vercel rewrites + Railway proxy: TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# ---- Database (DATABASE_URL wins; Railway injects it automatically) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ielts_practice?sslmode=disable

# ---- Auth ----
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Google OAuth (Google Cloud Console → Credentials → OAuth client "Web application") ----
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# ---- Card generation (Epic 3) ----
# Claude writes the card content. Without a key, generation fails with VOCAB_GENERATOR_NOT_CONFIGURED.
ANTHROPIC_API_KEY=
VOCAB_LLM_MODEL=claude-haiku-5-5
VOCAB_LLM_EFFORT=low
# Gemini answers the words Claude could not (errors, overload, refusals), or every word when only
# GEMINI_API_KEY is set. Leave VOCAB_FALLBACK_MODEL unset for the default; set it empty to disable.
GEMINI_API_KEY=
VOCAB_FALLBACK_MODEL=gemini-3.1-flash-lite
# Background generation goroutines and the per-user limit of newly generated words per 24 h.
VOCAB_WORKERS=4
VOCAB_DAILY_QUOTA=50
# Image search order. Images are hotlinked from the providers, never stored in S3.
VOCAB_IMAGE_PROVIDERS=pixabay,unsplash
PIXABAY_API_KEY=
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
# Offline fakes for Claude and the image APIs (development and e2e only; ignored in production).
VOCAB_FAKE_PROVIDERS=false

# ---- Object storage (S3), reserved for future user uploads ----
S3_BUCKET_NAME=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible servers (MinIO / RustFS), e.g. http://localhost:9000
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
